{
  "expo": {
    "name": "Spendly",
    "slug": "spendly",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/icon.png",

    "scheme": "spendly",

    "userInterfaceStyle": "dark",

    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png"
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1B3B",
        "foregroundImage": "./assets/icon.png",
        "monochromeImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "output": "server",
      "favicon": "./assets/icon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1B3B",
          "image": "./assets/splash.png",
          "imageWidth": 300,
          "resizeMode": "contain"
        }
      ],
      "expo-sqlite"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}